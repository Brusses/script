@nightyScript(
    name="Channel Unique Authors",
    author="0pyr",
    description="Collects unique message authors from a selected text channel",
    usage="Select server, channel and limit, then click Fetch"
)
def ChannelUniqueAuthors():
    import asyncio

    def build_server_items():
        items = [{"id": "select_server", "title": "Select server"}]
        for guild in bot.guilds:
            items.append({
                "id": str(guild.id),
                "title": guild.name,
                "iconUrl": guild.icon.url if guild.icon else "https://cdn.discordapp.com/embed/avatars/0.png"
            })
        return items

    def copy_to_clipboard(text):
        if not text:
            return False
        try:
            setClipboard(text)
            return True
        except Exception:
            pass
        try:
            clipboard.write(text)
            return True
        except Exception:
            pass
        return False

    tab = Tab(name="Moderation Tools", title="Unique Authors", icon="shield", gap=2)
    container = tab.create_container(type="rows", gap=2)

    controls = container.create_card(gap=2)
    server_select = controls.create_ui_element(
        UI.Select,
        label="Serwer",
        items=build_server_items(),
        disabled_items=["select_server"],
        mode="single",
        full_width=True
    )
    channel_select = controls.create_ui_element(
        UI.Select,
        label="Kanał tekstowy",
        items=[{"id": "select_channel", "title": "Najpierw wybierz serwer"}],
        disabled_items=["select_channel"],
        mode="single",
        full_width=True
    )
    limit_input = controls.create_ui_element(UI.Input, label="Limit użytkowników", placeholder="np. 25")

    fetch_button = controls.create_ui_element(UI.Button, label="Pobierz listę", variant="cta", full_width=True)
    copy_button = controls.create_ui_element(UI.Button, label="Skopiuj wszystko", variant="secondary", full_width=True)

    results_card = container.create_card(gap=1)
    results_card.create_ui_element(UI.Text, content="Wynik", size="lg", weight="bold")
    result_text = results_card.create_ui_element(UI.Text, content="Brak danych.", size="sm")

    def update_channel_list(selected_server_ids):
        if not selected_server_ids or selected_server_ids[0] in ["", "select_server"]:
            channel_select.items = [{"id": "select_channel", "title": "Najpierw wybierz serwer"}]
            channel_select.disabled_items = ["select_channel"]
            return

        guild = bot.get_guild(int(selected_server_ids[0]))
        if not guild:
            channel_select.items = [{"id": "select_channel", "title": "Nie udało się pobrać kanałów"}]
            channel_select.disabled_items = ["select_channel"]
            return

        items = [{"id": "select_channel", "title": "Wybierz kanał"}]
        for ch in guild.text_channels:
            items.append({"id": str(ch.id), "title": f"#{ch.name}"})

        channel_select.items = items
        channel_select.disabled_items = ["select_channel"]

    async def fetch_unique_authors():
        if not server_select.selected_items or server_select.selected_items[0] in ["", "select_server"]:
            tab.toast(type="ERROR", title="Błąd", description="Wybierz serwer.")
            return

        if not channel_select.selected_items or channel_select.selected_items[0] in ["", "select_channel"]:
            tab.toast(type="ERROR", title="Błąd", description="Wybierz kanał tekstowy.")
            return

        try:
            limit = int(limit_input.value.strip()) if limit_input.value else 25
        except Exception:
            tab.toast(type="ERROR", title="Błąd", description="Limit musi być liczbą całkowitą.")
            return

        if limit <= 0:
            tab.toast(type="ERROR", title="Błąd", description="Limit musi być większy od 0.")
            return

        channel = bot.get_channel(int(channel_select.selected_items[0]))
        if not channel:
            tab.toast(type="ERROR", title="Błąd", description="Brak dostępu do kanału.")
            return

        fetch_button.loading = True
        try:
            unique_ids = set()
            mentions = []

            async for message in channel.history(limit=5000, oldest_first=False):
                author_id = message.author.id
                if author_id in unique_ids:
                    continue

                unique_ids.add(author_id)
                mentions.append(f"<@{author_id}>")

                if len(mentions) >= limit:
                    break

            if not mentions:
                result_text.content = "Nie znaleziono autorów wiadomości."
                tab.toast(type="INFO", title="Gotowe", description="Brak wyników.")
                return

            result_text.content = "\n".join(mentions)
            tab.toast(type="SUCCESS", title="Gotowe", description=f"Znaleziono {len(mentions)} unikalnych autorów.")
        except Exception as e:
            result_text.content = f"Wystąpił błąd: {e}"
            tab.toast(type="ERROR", title="Błąd", description="Nie udało się pobrać autorów.")
        finally:
            fetch_button.loading = False

    async def copy_all_results():
        text = result_text.content if result_text.content and result_text.content != "Brak danych." else ""
        if not text:
            tab.toast(type="ERROR", title="Brak danych", description="Najpierw pobierz listę.")
            return

        if copy_to_clipboard(text):
            tab.toast(type="SUCCESS", title="Skopiowano", description="Wszystkie wyniki zostały skopiowane.")
        else:
            tab.toast(type="ERROR", title="Błąd", description="Nie udało się skopiować do schowka.")

    server_select.onChange = update_channel_list
    fetch_button.onClick = fetch_unique_authors
    copy_button.onClick = copy_all_results

    tab.render()


ChannelUniqueAuthors()
